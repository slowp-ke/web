---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
	isBouncing?: boolean;
}
const { class: extraClasses, isBouncing = false, ...rest } = Astro.props;
---

<a
	{...rest}
	class:list={[extraClasses]}
	href="https://www.google.com/search?q=slowpoke"
	inert={isBouncing ? true : undefined}
	rel="external"
	title="slowpoke"
>
	<i></i>
</a>

<style is:global>
	i {
		display: block;
		width: 48px;
		height: 48px;
		background-size: 48px 48px;
		image-rendering: pixelated;
		background-image: url("data:image/gif;base64,");
	}
</style>
