---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
	scale?: number;
}

const { class: extraClasses, ...rest } = Astro.props;
---

<a
	{...rest}
	aria-label="slowpoke"
	class:list={["s", extraClasses]}
	href="https://veekun.com/dex/pokemon/slowpoke"
	rel="external"
	target="_blank"
	title="slowpoke"><span aria-hidden="true"></span></a
>

<style is:global>
	.s > span {
		display: block;
		width: 24px;
		height: 24px;

		background-image: url("data:image/gif;base64,");
	}
</style>
