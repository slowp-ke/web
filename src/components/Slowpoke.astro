---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;
const { class: extraClasses, ...rest } = Astro.props;
---

<a
	{...rest}
	aria-label="slowpoke"
	class:list={[extraClasses]}
	href="https://www.google.com/search?q=slowpoke"
	rel="external"
	target="_blank"
	title="slowpoke"><span aria-hidden="true" class="s"></span></a
>

<style is:global>
	.s {
		display: block;
		width: 48px;
		height: 48px;
		background-size: 48px 48px;
		image-rendering: pixelated;
		background-image: url("data:image/gif;base64,");
	}
</style>
