---
import Bouncer from "~/components/Bouncer.astro";
import Slowpoke from "~/components/Slowpoke.astro";
import Layout from "~/layouts/Default.astro";
---

<Layout>
	<main>
		<Slowpoke class="m" />
		<Bouncer />
	</main>
</Layout>

<style is:global>
	/* is:global prevents `data-astro` attributes from being added to the build output.
	site is very simple so I'm not worried about scoped styles here. */

	.m {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
	}
</style>
