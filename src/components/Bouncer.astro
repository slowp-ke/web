---
import Slowpoke from "~/components/Slowpoke.astro";

interface Props {
	number?: number;
}
const { number = 78 } = Astro.props;
---

{Array.from({ length: number }, () => (
	<Slowpoke class="b" isBouncing />
))}

<script>
	const slowpokes = document.getElementsByClassName("b");
	const base = {
		direction: "alternate" as PlaybackDirection,
		easing: "linear",
		iterations: Infinity
	};
	const horizontal = { transform: "translateX(calc(100dvw - 48px))" };
	const vertical = { transform: "translateY(calc(100dvh - 48px))" };

	requestAnimationFrame(() => {
		for (const s of slowpokes) {
			const x = Math.random() * 1e4 + 0.1;
			const y = Math.random() * 1e4 + 0.1;

			s.animate(horizontal, {
				...base,
				duration: x,
				iterationStart: Math.random() * 100
			});
			s.firstElementChild!.animate(vertical, {
				...base,
				duration: y,
				iterationStart: Math.random() * 100
			});
		}
	});
</script>

<style is:global>
	.b {
		position: absolute;
		opacity: 0.05;
	}
</style>
