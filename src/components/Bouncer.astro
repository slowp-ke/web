---
import Slowpoke from "~/components/Slowpoke.astro";

interface Props {
	number?: number;
}
const { number = 79 } = Astro.props;
---

{Array.from({ length: number }, () => <Slowpoke class="b" />)}

<script>
	const slowpokes = document.getElementsByClassName("b");
	const base = {
		direction: "alternate" as PlaybackDirection,
		easing: "linear",
		iterations: Infinity
	};

	for (const s of slowpokes) {
		const x = Math.random() * 1e4 + 0.1;
		const y = Math.random() * 1e4 + 0.1;

		requestAnimationFrame(() => {
			s.animate(
				{ transform: "translateX(calc(100vw - 24px))" },
				{ ...base, duration: x, iterationStart: Math.random() * 100 }
			);
			s.firstElementChild!.animate(
				{ transform: "translateY(calc(100vh - 24px))" },
				{ ...base, duration: y, iterationStart: Math.random() * 100 }
			);
		});
	}
</script>

<style is:global>
	.b {
		position: absolute;
	}
</style>
